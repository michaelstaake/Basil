# Dependencies
node_modules/

# Build output
dist/
dist-electron/
release/
*.tsbuildinfo

# Tool caches
.vite/
.eslintcache
coverage/
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and secrets.
# Basil keeps its API key in %USERPROFILE%\.basil\ai.json, outside the repo, but
# never let a stray local env file be committed.
.env
.env.*
!.env.example

# Code signing material — must never be committed
*.pfx
*.p12
*.snk
certificate.*

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
