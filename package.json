{
  "name": "basil",
  "version": "26.7.1",
  "description": "Basil Text Editor",
  "author": "Michael Staake",
  "license": "GPL-3.0-or-later",
  "private": true,
  "homepage": "https://github.com/michaelstaake/Basil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelstaake/Basil.git"
  },
  "bugs": {
    "url": "https://github.com/michaelstaake/Basil/issues"
  },
  "main": "dist-electron/main.js",
  "desktopName": "com.basil.editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/with-build-version.mjs --win",
    "build:dir": "vite build && node scripts/with-build-version.mjs --win dir",
    "build:deb": "vite build && node scripts/with-build-version.mjs --linux deb --x64",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "//dependencies": "Everything the app uses at runtime is bundled into dist/ by Vite, so there are no production dependencies. Anything listed here would be packed into app.asar a second time.",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/google-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "lucide-react": "^0.525.0",
    "monaco-editor": "^0.52.2",
    "png-to-ico": "^2.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.basil.editor",
    "productName": "Basil",
    "copyright": "Michael Staake",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/**"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.mjs",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Basil-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Basil-${version}-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons",
      "executableName": "basil",
      "category": "Utility;TextEditor",
      "synopsis": "Intuitive text editor",
      "description": "An intuitive text editor with optional AI assistance.",
      "maintainer": "Michael Staake <michael@staake.ai>",
      "syncDesktopName": true,
      "mimeTypes": [
        "text/plain",
        "text/markdown",
        "text/x-markdown",
        "text/html",
        "text/css",
        "text/javascript",
        "application/javascript",
        "application/json",
        "application/xml",
        "text/xml",
        "text/x-python",
        "text/x-shellscript",
        "text/csv",
        "text/yaml",
        "application/x-yaml"
      ],
      "desktop": {
        "entry": {
          "Name": "Basil",
          "GenericName": "Text Editor",
          "Keywords": "text;editor;notes;markdown;",
          "StartupNotify": "true"
        }
      },
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ]
    },
    "deb": {
      "artifactName": "Basil-${version}-${arch}.${ext}",
      "packageName": "basil",
      "packageCategory": "editors",
      "priority": "optional",
      "depends": [
        "libc6 (>= 2.25)",
        "libgtk-3-0t64 | libgtk-3-0",
        "libglib2.0-0t64 | libglib2.0-0",
        "libatk1.0-0t64 | libatk1.0-0",
        "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libasound2t64 | libasound2",
        "libcups2t64 | libcups2",
        "libdrm2",
        "libgbm1",
        "libnotify4",
        "libnspr4",
        "libnss3",
        "libx11-xcb1",
        "libxcb-dri3-0",
        "libxcomposite1",
        "libxdamage1",
        "libxfixes3",
        "libxkbcommon0",
        "libxrandr2",
        "libxss1",
        "libxtst6",
        "libudev1",
        "libsecret-1-0",
        "libuuid1",
        "xdg-utils"
      ],
      "recommends": [
        "libayatana-appindicator3-1"
      ]
    }
  }
}
